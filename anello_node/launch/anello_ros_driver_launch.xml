<!-- Compatibility entry point: all implementation and defaults live in Python. -->
<launch>
  <arg name="ntrip_host" default=""/>
  <arg name="host" default="$(var ntrip_host)"/>
  <arg name="ntrip_port" default=""/>
  <arg name="port" default="$(var ntrip_port)"/>
  <arg name="ntrip_mountpoint" default=""/>
  <arg name="mountpoint" default="$(var ntrip_mountpoint)"/>
  <arg name="ntrip_authenticate" default=""/>
  <arg name="authenticate" default="$(var ntrip_authenticate)"/>
  <arg name="ntrip_username" default=""/>
  <arg name="username" default="$(var ntrip_username)"/>
  <arg name="ntrip_password" default=""/>
  <arg name="password" default="$(var ntrip_password)"/>
  <arg name="ntrip_ssl" default=""/>
  <arg name="ssl" default="$(var ntrip_ssl)"/>
  <arg name="ntrip_cert" default=""/>
  <arg name="cert" default="$(var ntrip_cert)"/>
  <arg name="ntrip_key" default=""/>
  <arg name="key" default="$(var ntrip_key)"/>
  <arg name="ntrip_ca_cert" default=""/>
  <arg name="ca_cert" default="$(var ntrip_ca_cert)"/>
  <include file="$(find-pkg-share anello_ros_driver)/launch/anello_driver.launch.py">
    <arg name="ntrip_host" value="$(var host)"/>
    <arg name="ntrip_port" value="$(var port)"/>
    <arg name="ntrip_mountpoint" value="$(var mountpoint)"/>
    <arg name="ntrip_authenticate" value="$(var authenticate)"/>
    <arg name="ntrip_username" value="$(var username)"/>
    <arg name="ntrip_password" value="$(var password)"/>
    <arg name="ntrip_ssl" value="$(var ssl)"/>
    <arg name="ntrip_cert" value="$(var cert)"/>
    <arg name="ntrip_key" value="$(var key)"/>
    <arg name="ntrip_ca_cert" value="$(var ca_cert)"/>
  </include>
</launch>
