<?xml version="1.0"?>
<package format="3">
  <name>ntrip_client</name>
  <version>3.1.0</version>
  <description>NTRIP client for the ANELLO ROS2 driver</description>
  <maintainer email="austin.johnson@anellophotonics.com">Austin Johnson</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nmea_msgs</depend>
  <depend>rtcm_msgs</depend>

  <!-- ament_copyright is intentionally not run here (see test/): the
       codebase predates per-file copyright headers, matching the same
       call made for anello_ros_driver's CMakeLists.txt. -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
